alignment = 1

[node name="Spacer" type="Control" parent="Margin/Layout/Panels/JoinPanel/Join"]
layout_mode = 2
size_flags_vertical = 3

[node name="JoinButton" type="Button" parent="Margin/Layout/Panels/JoinPanel/Join"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
text = "JOIN"

[node name="Status" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
